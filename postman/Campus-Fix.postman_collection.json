    {
      "name": "Incidencias",
      "item": [
        {
          "name": "Registrar (exitoso)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{usuario_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Proyector sin imagen\",\n  \"descripcion\": \"El proyector del lab 1 no muestra imagen\",\n  \"prioridad\": \"Media\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/incidencias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.environment.set('incidencia_id', json.id_incidencia);"
                ]
              }
            }
          ]
        },

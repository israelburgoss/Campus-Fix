                  "pm.environment.set('tecnico_token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Usuario (exitoso)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"juan.perez@ecotec.edu.ec\",\n  \"contrasena\": \"CampusFix2026!\"\n}",
              "options": { "raw": { "language": "json" } }
